#!/bin/sh
# SPDX-License-Identifier: MIT
set -eu
product=${1:?usage: scripts/package-product PRODUCT OUTPUT_DIRECTORY}
out=${2:?usage: scripts/package-product PRODUCT OUTPUT_DIRECTORY}
case "$product" in pi|omp) ;; *) echo 'Unsupported product; use pi or omp.' >&2; exit 1;; esac
mkdir -p "$out"
out=$(CDPATH='' cd "$out" && pwd -P)
repo=$(CDPATH='' cd "$(dirname "$0")/.." && pwd -P)
cd "$repo"
. "$repo/scripts/release/version.sh"
peer_version_init "$repo"
stage=$(CDPATH='' cd "$(mktemp -d)" && pwd -P)
trap 'rm -rf "$stage"' 0
trap 'exit 1' HUP INT TERM
platform=${GOOS:-$(go env GOOS)}
arch=${GOARCH:-$(go env GOARCH)}
CGO_ENABLED=0 GOOS="$platform" GOARCH="$arch" peer_go_build "$stage/$product-peer" "./cmd/$product-peer"
mkdir "$stage/plugin"
if [ "$product" = pi ]; then
 mkdir -p "$stage/plugin/pi" "$stage/plugin/pifamily/extension"
 cp wrappers/pi/extension.mjs wrappers/pi/native.mjs "$stage/plugin/pi/"
 cp wrappers/pifamily/extension/bridge.mjs "$stage/plugin/pifamily/extension/"
else
 mkdir -p "$stage/plugin/omp" "$stage/plugin/pifamily/extension"
 cp wrappers/omp/extension.mjs "$stage/plugin/omp/"
 cp wrappers/pifamily/extension/bridge.mjs "$stage/plugin/pifamily/extension/"
fi
cp scripts/release/THIRD-PARTY-NOTICES.txt LICENSE "$stage/"
printf '%s\n' "$peer_revision" > "$stage/SOURCE.txt"
cp scripts/release/install-product "$stage/install"
if [ -f "$product/README.md" ]; then cp "$product/README.md" "$stage/README.md"; else cp "docs/products/$product.md" "$stage/README.md"; fi
printf '%s\n' "$product" > "$stage/ROLE"
tar -czf "$out/$product-peer-$platform-$arch.tar.gz" -C "$stage" "$product-peer" plugin LICENSE THIRD-PARTY-NOTICES.txt README.md install ROLE SOURCE.txt
